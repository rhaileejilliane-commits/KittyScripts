                    local currentTime = os.clock()
                    if currentTime - lastJumpTime < jumpCooldown then return end
                    lastJumpTime = currentTime
                    rootPart.AssemblyLinearVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, math.clamp(humanoid.JumpPower, 30, 50), rootPart.AssemblyLinearVelocity.Z)
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
