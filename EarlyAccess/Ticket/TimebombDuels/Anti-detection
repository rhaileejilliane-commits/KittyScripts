    ["Orange"] = Color3.fromRGB(255, 128, 0),
    ["Purple"] = Color3.fromRGB(128, 0, 255),
    ["Lime"] = Color3.fromRGB(128, 255, 0),
}

local function applyTrailColor(col)
    currentTrailColor = col
    if activeTrail and not rainbowTrailConnection then
        activeTrail.Color = ColorSequence.new(col)
    end
end

local function toggleTrail(state)
    trailEnabled = state
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if trailEnabled and hrp then
        if not activeTrail then
            local att0 = Instance.new("Attachment", hrp)
            att0.Name = "TrailAtt0"
            att0.Position = Vector3.new(0, -1, 0)
            
            local att1 = Instance.new("Attachment", hrp)
            att1.Name = "TrailAtt1"
            att1.Position = Vector3.new(0, 1, 0)
            
            activeTrail = Instance.new("Trail")
            activeTrail.Name = "KittyHubTrail"
            activeTrail.Attachment0 = att0
            activeTrail.Attachment1 = att1
            activeTrail.Color = ColorSequence.new(currentTrailColor)
            activeTrail.Lifetime = 0.6
            activeTrail.MinLength = 0.1
            activeTrail.Parent = hrp
        end
    else
        if activeTrail then
            activeTrail:Destroy()
            activeTrail = nil
        end
        if rainbowTrailConnection then
            rainbowTrailConnection:Disconnect()
            rainbowTrailConnection = nil
        end
        if hrp then
            for _, att in ipairs(hrp:GetChildren()) do
                if att.Name:find("TrailAtt") then att:Destroy() end
            end
        end
    end
end

