local trailEnabled = false
local currentTrailColor = Color3.fromRGB(255, 105, 180)
local activeTrail = nil
local rainbowTrailConnection = nil

local colorPresets = {
    ["PinkFade"] = Color3.fromRGB(255, 105, 180),
    ["Hot Pink"] = Color3.fromRGB(255, 20, 147),
    ["White"] = Color3.fromRGB(255, 255, 255),
