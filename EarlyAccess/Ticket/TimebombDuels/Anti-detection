local function isTeammateCheck(player)
    if player == LocalPlayer then return true end
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return true
    end
    local pChar = player.Character
    if pChar then
        for _, child in ipairs(pChar:GetChildren()) do
            if (child:IsA("Highlight") and child.Enabled) or child:IsA("Team") or child.Name:lower():find("team") then
                return true
            end
        end
    end
    if player:GetAttribute("Team") and LocalPlayer:GetAttribute("Team") then
        if player:GetAttribute("Team") == LocalPlayer:GetAttribute("Team") then
            return true
        end
    end
    return false
end

