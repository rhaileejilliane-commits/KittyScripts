                    stroke.Color = Color3.fromRGB(255, 20, 147)
                    stroke.Thickness = 1
                    stroke.Parent = btn

                    btn.MouseButton1Click:Connect(callback)
                    return btn
                end

                createButton("RecordBtn", "Record", 85, function()
                    if isPlaying then return end
                    recordedFrames = {}
                    isRecording = true
                    updateRecorderUIState("Recording...", Color3.fromRGB(255, 105, 180))
                    
                    local startTime = tick()
                    if recordConnection then recordConnection:Disconnect() end
                    recordConnection = RunService.RenderStepped:Connect(function()
                        if not isRecording then return end
                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            table.insert(recordedFrames, {
                                CFrame = hrp.CFrame,
                                Time = tick() - startTime
                            })
                        end
                    end)
                end)

                createButton("StopBtn", "Stop Record", 125, function()
                    isRecording = false
                    if recordConnection then
                        recordConnection:Disconnect()
                        recordConnection = nil
                    end
                    updateRecorderUIState("Stopped (" .. #recordedFrames .. " frames)", Color3.fromRGB(218, 112, 214))
                end)

                createButton("PlayBtn", "Play Record", 165, function()
                    if isRecording or #recordedFrames == 0 then
                        updateRecorderUIState("No data or recording!", Color3.fromRGB(255, 50, 50))
                        return
                    end
                    isPlaying = true
                    updateRecorderUIState("Playing...", Color3.fromRGB(50, 255, 50))

                    task.spawn(function()
                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                        if hrp and humanoid then
                            local oldPlatformStand = humanoid.PlatformStand
                            humanoid.PlatformStand = true

                            local playStartTime = tick()
                            local index = 1
                            local totalFrames = #recordedFrames
                            
                            if playbackConnection then playbackConnection:Disconnect() end
                            playbackConnection = RunService.RenderStepped:Connect(function()
                                if not isPlaying then return end
                                local elapsedTime = tick() - playStartTime

                                while index < totalFrames and recordedFrames[index + 1].Time <= elapsedTime do
                                    index = index + 1
                                end

                                if index < totalFrames then
                                    local currentFrame = recordedFrames[index]
                                    local nextFrame = recordedFrames[index + 1]
                                    
                                    local alpha = 0
                                    local timeDiff = nextFrame.Time - currentFrame.Time
                                    if timeDiff > 0 then
                                        alpha = math.clamp((elapsedTime - currentFrame.Time) / timeDiff, 0, 1)
                                    end

                                    hrp.CFrame = currentFrame.CFrame:Lerp(nextFrame.CFrame, alpha)
                                    hrp.AssemblyLinearVelocity = Vector3.zero
                                    hrp.AssemblyAngularVelocity = Vector3.zero
                                else
                                    if totalFrames > 0 then
                                        hrp.CFrame = recordedFrames[totalFrames].CFrame
                                    end
                                    isPlaying = false
                                    if playbackConnection then
                                        playbackConnection:Disconnect()
                                        playbackConnection = nil
                                    end
                                    humanoid.PlatformStand = oldPlatformStand
                                    updateRecorderUIState("Playback Finished", Color3.fromRGB(255, 105, 180))
                                end
                            end)
                        else
                            isPlaying = false
                            updateRecorderUIState("Character not found!", Color3.fromRGB(255, 50, 50))
                        end
                    end)
                end)
            else
                recorderUIInstance.Enabled = true
            end
        else
            if recorderUIInstance then
                recorderUIInstance.Enabled = false
            end
        end
    end
})

