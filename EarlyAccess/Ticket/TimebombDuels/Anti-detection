local originalHeadData = {}
local function applyHeadlessState(char, state)
    local head = char:FindFirstChild("Head")
    if not head then return end
    
    if not originalHeadData[head] then
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        originalHeadData[head] = {
            Transparency = head.Transparency,
            MeshId = mesh and mesh.MeshId or "",
            TextureId = mesh and mesh.TextureId or "",
            FaceTrans = head:FindFirstChild("face") and head:FindFirstChild("face").Transparency or 0
        }
    end
    
    if state then
        head.Transparency = 1
        local face = head:FindFirstChild("face")
        if face then face.Transparency = 1 end
        local mesh = head:FindFirstChildOfClass("SpecialMesh")
        if mesh then
            mesh.MeshId = "rbxassetid://1095708"
            mesh.TextureId = ""
        else
            local newMesh = Instance.new("SpecialMesh")
            newMesh.MeshId = "rbxassetid://1095708"
            newMesh.Parent = head
        end
    else
        local data = originalHeadData[head]
        if data then
            head.Transparency = data.Transparency
            local face = head:FindFirstChild("face")
            if face then face.Transparency = data.FaceTrans end
            local mesh = head:FindFirstChildOfClass("SpecialMesh")
            if mesh then
                mesh.MeshId = data.MeshId
                mesh.TextureId = data.TextureId
            end
        end
    end
end

