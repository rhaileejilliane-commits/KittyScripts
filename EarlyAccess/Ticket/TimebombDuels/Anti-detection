local originalLegData = {}
local function applyKorbloxState(char, state)
    local rightLeg = char:FindFirstChild("Right Leg")
    if not rightLeg then return end
    
    if not originalLegData[rightLeg] then
        local existingMesh = rightLeg:FindFirstChildOfClass("SpecialMesh")
        originalLegData[rightLeg] = {
            Transparency = rightLeg.Transparency,
            HasMesh = existingMesh ~= nil,
            MeshId = existingMesh and existingMesh.MeshId or "",
            TextureId = existingMesh and existingMesh.TextureId or "",
            Scale = existingMesh and existingMesh.Scale or Vector3.new(1,1,1)
        }
    end
    
    for _, child in ipairs(rightLeg:GetChildren()) do
        if child:IsA("SpecialMesh") then child:Destroy() end
    end
    
    if state then
        rightLeg.Transparency = 0
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://101851696"
        mesh.TextureId = "rbxassetid://101851254"
        mesh.Scale = Vector3.new(1, 1, 1)
        mesh.Parent = rightLeg
    else
        local data = originalLegData[rightLeg]
        if data and data.HasMesh then
            rightLeg.Transparency = data.Transparency
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshId = data.MeshId
            mesh.TextureId = data.TextureId
            mesh.Scale = data.Scale
            mesh.Parent = rightLeg
        else
            rightLeg.Transparency = 0
        end
    end
end

