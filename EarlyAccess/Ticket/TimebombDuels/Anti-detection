CombatTab:Section({ Title = "Hitbox Expander" })

local HitboxEnabled = false
local HitboxSizeValue = 5
local HitboxColor = Color3.fromRGB(255, 105, 180)
local originalHitboxPartData = {}
local floorCylinderVisual = nil

local function applyHitboxExpansion(p, currentSize)
    local char = p.Character
    if not char then return end
    
    local partsToExpand = {"Head", "Torso", "HumanoidRootPart", "UpperTorso", "LowerTorso"}
    for _, partName in ipairs(partsToExpand) do
        local part = char:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            if not originalHitboxPartData[part] then
                originalHitboxPartData[part] = {
                    Size = part.Size,
                    Transparency = part.Transparency,
                    CanCollide = part.CanCollide
                }
            end
            
            if p ~= LocalPlayer and not isTeammateCheck(p) then
                part.Size = Vector3.new(currentSize, currentSize, currentSize)
                part.Transparency = 1
                part.CanCollide = false
                pcall(function()
                    part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                end)
            end
        end
    end
end

local function resetHitboxExpansion(p)
    local char = p.Character
    if not char then return end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and originalHitboxPartData[part] then
            part.Size = originalHitboxPartData[part].Size
            part.Transparency = originalHitboxPartData[part].Transparency
            part.CanCollide = originalHitboxPartData[part].CanCollide
            originalHitboxPartData[part] = nil
        end
    end
end

